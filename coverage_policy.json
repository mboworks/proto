{
  "include": ["mbo/proto/**"],
  "exclude": ["mbo/proto/**/*_test.cc", "mbo/proto/tests/**"],
  "minimum": { "lines": 90, "functions": 90, "branches": 85 },
  "target": { "lines": 95, "functions": 95, "branches": 90 },
  "enforce": { "lines": "high", "functions": "high", "branches": "high" },
  "patch": {
    "minimum": { "lines": 85, "branches": 70 },
    "target": { "lines": 95, "branches": 85 },
    "enforce": "medium"
  },
  "categories": {
    "proto": { "include": ["mbo/proto/**"] }
  }
}
